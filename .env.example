# PostgreSQL connection string. Plain URL: do NOT add ?replication=database
# (the service adds it for the replication connection itself).
DATABASE_URL=postgres://pg:pg@127.0.0.1:5432/db
# Logical replication slot created with `outy setup replication` (replication service only)
REPLICATION_SLOT_NAME=outbox_slot

# NATS Configuration
# These variables override the matching values in publisher.yaml. If the file at
# PUBLISHER_CONFIG_PATH does not exist, NATS_SERVERS + NATS_SUBJECT_PREFIX alone are
# enough (env-only mode).
# Comma-separated server URLs (TARGET_NATS_URL is a deprecated alias)
NATS_SERVERS=nats://localhost:4222
# Messages are published to <NATS_SUBJECT_PREFIX>.<eventType>. A JetStream stream whose
# subjects match "<prefix>.>" must exist, e.g.:
#   nats stream add OUTBOX --subjects 'events.>' --dupe-window 2m --defaults
NATS_SUBJECT_PREFIX=events
# NATS_USER=
# NATS_PASSWORD=
# NATS_TOKEN=
# NATS_CONNECTION_NAME=outbox-reader

# Health check server port (default: 4599)
PORT=4599

# Log level: trace | debug | info | warn | error (default: info)
LOG_LEVEL=info

# Database pool size for the replication service (integer >= 1, default: 10)
DB_POOL_SIZE=10

# Max publish attempts per outbox record before giving up (integer >= 1, default: 5)
MAX_OUTBOX_ATTEMPTS=5

# Outbox column naming: snake_case | camelCase | PascalCase (default: snake_case)
COLUMN_NAMING=snake_case

# Outbox table name (default: outbox)
TABLE_NAME=outbox

# Path to the publisher YAML config (default: ./publisher.yaml). Optional in env-only mode.
PUBLISHER_CONFIG_PATH=./publisher.yaml

# check-pending-events cronjob: age in minutes after which PENDING events are republished (integer >= 1, default: 10)
# Cronjobs do not require REPLICATION_SLOT_NAME.
PENDING_EVENTS_THRESHOLD_MINUTES=10

# purge-processed-events cronjob: delete PROCESSED records older than N days (integer >= 1, default: 7)
PROCESSED_RETENTION_DAYS=7

# purge-processed-events cronjob: delete DEAD records older than N days (integer >= 1).
# Unset (default) = DEAD records are never purged, so they stay available for inspection.
# DEAD_RETENTION_DAYS=90

# Telemetry
# Prometheus metrics exporter (default: enabled on port 9464 at /metrics)
PROMETHEUS_PORT=9464
# Set to "false" to push metrics via OTLP instead of exposing the Prometheus endpoint
# PROMETHEUS_EXPORTER_ENABLED=true
# OTLP/HTTP endpoint for logs (and metrics when Prometheus is disabled)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=outbox-reader
# OTEL_METRICS_EXPORT_INTERVAL_MS=30000
